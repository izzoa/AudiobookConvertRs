{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudiobookConvertRs",
  "version": "0.1.0",
  "identifier": "com.audiobookconvert.rs",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../src-ui && npm run dev",
    "beforeBuildCommand": "cd ../src-ui && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AudiobookConvertRs",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "category": "Utility",
    "shortDescription": "Convert audio files to M4B audiobook format",
    "longDescription": "A cross-platform audiobook converter that converts various audio formats (MP3, FLAC, M4A, WAV, OGG) to M4B audiobook format with chapters, metadata, and artwork support.",
    "copyright": "Copyright © 2025 AudiobookConvertRs Contributors",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
