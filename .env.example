# AudiobookConvertRs Environment Variables
# Copy this file to .env for local development

# FFmpeg executable path (optional, auto-detected if in PATH)
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# Output directory (optional, defaults to user's home directory)
# DEFAULT_OUTPUT_DIR=/path/to/output
